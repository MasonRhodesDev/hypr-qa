#!/usr/bin/env bash
# build — produce the plain-hyprland guest from scratch on the KVM host.
#
#   profiles/plain-hyprland/build
#
# 1. cache the newest Arch Linux cloud image (sha256-verified) under
#    $BASE_DIR; later builds reuse it until a newer one is published
# 2. create a fresh per-profile qcow2 overlay on it ($OVERLAY)
# 3. build the cloud-init NoCloud seed ISO ($SEED) with xorriso
# 4. first boot via `vmkit up`: cloud-init creates user qa and starts the
#    provisioning service (full upgrade, hyprland/foot/fonts/greetd, config)
# 5. reboot into greetd autologin -> Hyprland, wait for the session
# 6. check the session (1280x800, no config errors, the pointer is the
#    cursor theme's), let the screen settle,
#    save the `session-ready` snapshot, shut down
#
# Destroys any previous overlay (and its snapshots); keeps cached base images.
# Run heavy: everything here is nice 19 / ionice idle.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=profile.env
. "$HERE/profile.env"
VM="$HERE/vm"

T0=$(date +%s)
declare -a TIMINGS=()
phase_start=$T0
phase() {  # phase "name" — close the previous phase's timing and announce the next
    local now; now=$(date +%s)
    [ -n "${cur_phase:-}" ] && TIMINGS+=("$(printf '%-22s %4ss' "$cur_phase" $((now - phase_start)))")
    cur_phase="$1"; phase_start=$now
    [ "$1" = end ] || echo "== [$((now - T0))s] $1"
}
die() {
    echo "build: $*" >&2
    if [ -S "$VMKIT_DIR/qmp.sock" ]; then
        echo "--- serial (last 30) ---" >&2; tail -n 30 "$VMKIT_DIR/serial.log" >&2 || true
        echo "(VM left running for inspection: $VM ssh / $VM down)" >&2
    fi
    exit 1
}

for c in qemu-img xorriso curl sha256sum openssl python3 ss setsid ionice; do
    command -v "$c" >/dev/null || die "missing host tool: $c"
done
[ -x "$VMKIT" ] || die "vmkit not found at $VMKIT (set VMKIT=)"
[ -f "$SSH_PUB" ] || die "no ssh pubkey at $SSH_PUB"

# Refuse to clobber a running guest of this profile.
if [ -S "$VMKIT_DIR/qmp.sock" ] && "$VM" qmp '{"execute":"query-status"}' >/dev/null 2>&1; then
    die "plain-hyprland is running; '$VM down' first"
fi

# ---- 1. base image ----------------------------------------------------------
phase "base image"
mkdir -p "$BASE_DIR" "$PROFILE_DIR"
latest=$(curl -fsSL "$ARCH_IMAGES_URL/" \
    | grep -oE 'Arch-Linux-x86_64-cloudimg-[0-9]+\.[0-9]+\.qcow2' | sort -uV | tail -n1) \
    || die "could not read $ARCH_IMAGES_URL/"
[ -n "$latest" ] || die "no dated cloudimg in $ARCH_IMAGES_URL/"
BASE="$BASE_DIR/$latest"
if [ -f "$BASE" ]; then
    echo "   cached: $BASE"
else
    echo "   downloading $latest"
    want=$(curl -fsSL "$ARCH_IMAGES_URL/$latest.SHA256" | awk '{print $1}')
    [ -n "$want" ] || die "no checksum for $latest"
    nice -n 19 ionice -c3 curl -fL --progress-bar "$ARCH_IMAGES_URL/$latest" -o "$BASE.partial"
    got=$(nice -n 19 ionice -c3 sha256sum "$BASE.partial" | awk '{print $1}')
    [ "$got" = "$want" ] || { rm -f "$BASE.partial"; die "sha256 mismatch for $latest"; }
    mv "$BASE.partial" "$BASE"
    chmod a-w "$BASE"   # overlays point at it; it must never change
fi

# ---- 2. overlay ---------------------------------------------------------------
phase "overlay"
rm -rf "$VMKIT_DIR"
rm -f "$OVERLAY"
qemu-img create -q -f qcow2 -F qcow2 -b "$BASE" "$OVERLAY"
qemu-img resize -q "$OVERLAY" "$DISK_SIZE"
echo "   $OVERLAY -> $(basename "$BASE") ($DISK_SIZE)"

# ---- 3. seed ISO ----------------------------------------------------------------
phase "seed iso"
seed_dir="$PROFILE_DIR/seed"
rm -rf "$seed_dir"; mkdir -p "$seed_dir"
b64() { base64 -w0 "$HERE/files/$1"; }
python3 - "$HERE/user-data.tmpl" "$seed_dir/user-data" \
    "@SSH_PUBKEY@=$(tr -d '\n' <"$SSH_PUB")" \
    "@PASSWD_HASH@=$(openssl passwd -6 qa)" \
    "@PROVISION_B64@=$(b64 provision.sh)" \
    "@QA_SESSION_B64@=$(b64 qa-session)" \
    "@HYPRLAND_QA_B64@=$(b64 hyprland-qa.lua)" \
    "@GREETD_B64@=$(b64 greetd-autologin.toml)" \
    "@FOOT_INI_B64@=$(b64 foot.ini)" \
    "@QA_CURSOR_PLANE_B64@=$(b64 qa-cursor-plane)" \
    "@USB_RULE_B64@=$(b64 99-hypr-qa-usb-no-autosuspend.rules)" <<'PY'
import sys
src, dst, *subs = sys.argv[1:]
text = open(src).read()
for s in subs:
    k, v = s.split("=", 1)
    assert k in text, f"placeholder {k} not in template"
    text = text.replace(k, v)
open(dst, "w").write(text)
PY
grep -q '@[A-Z_]*@' "$seed_dir/user-data" && die "unfilled placeholder in user-data"
# Stable per build: cloud-init treats a new instance-id as a new machine.
cat >"$seed_dir/meta-data" <<EOF
instance-id: $PROFILE-$(date -u +%Y%m%d%H%M%S)
local-hostname: $PROFILE
EOF
rm -f "$SEED"
(cd "$seed_dir" && xorriso -as mkisofs -quiet -V cidata -J -r -o "$SEED" user-data meta-data)
echo "   $SEED"

# ---- 4. first boot + provisioning -------------------------------------------------
phase "first boot to ssh"
"$VM" up
"$VM" wait ssh 300 || die "ssh never came up"

phase "provisioning"
st=none
for _ in $(seq 1 360); do   # up to 30 min (full upgrade + install)
    st=$("$VM" ssh 'cat /var/lib/hypr-qa/status 2>/dev/null || echo none' 2>/dev/null || echo unreachable)
    case "$st" in
        ok) break ;;
        fail) "$VM" ssh 'sudo tail -n 40 /var/log/hypr-qa-provision.log' >&2 || true
              die "provisioning failed" ;;
    esac
    sleep 5
done
[ "$st" = ok ] || { "$VM" ssh 'sudo tail -n 40 /var/log/hypr-qa-provision.log' >&2 || true; die "provisioning timed out (status=$st)"; }
"$VM" ssh 'cloud-init status --wait >/dev/null 2>&1; cloud-init status; grep "== installed" /var/log/hypr-qa-provision.log' || true

# ---- 5. reboot into the autologin session -----------------------------------------
# Reboot rather than start greetd in place: the full upgrade may have replaced
# the kernel, and the snapshot should hold a normal boot.
phase "reboot to session"
"$VM" ssh 'sudo systemctl reboot' >/dev/null 2>&1 || true
for _ in $(seq 1 30); do "$VM" ssh true >/dev/null 2>&1 || break; sleep 1; done
"$VM" wait ssh 300 || die "ssh did not return after reboot"
phase "ssh to session"
"$VM" wait exec 'pgrep -u qa -x Hyprland' 180 \
    || { "$VM" ssh 'sudo journalctl -b -u greetd --no-pager | tail -n 30' >&2 || true; die "no Hyprland process"; }
"$VM" wait exec 'qa-session hyprctl monitors' 120 || die "hyprctl never answered in the session"

# ---- 6. checks, settle, snapshot --------------------------------------------------
phase "session checks"
mon=$("$VM" session hyprctl -j monitors)
echo "$mon" | python3 -c '
import json, sys
m = json.load(sys.stdin)
assert len(m) == 1, "expected 1 monitor, got %d" % len(m)
m = m[0]
print("   monitor %s %dx%d@%.0f scale %s" % (m["name"], m["width"], m["height"], m["refreshRate"], m["scale"]))
assert (m["width"], m["height"]) == (1280, 800), "resolution is not 1280x800"
' || die "monitor check failed"
errs=$("$VM" session hyprctl configerrors 2>&1 | grep -v '^[[:space:]]*$' || true)
case "$errs" in
    ""|"no errors"*|"No errors"*) echo "   config errors: none" ;;
    *) printf '%s\n' "$errs" >&2; die "Hyprland reports config errors" ;;
esac
"$VM" session hyprctl version | head -n1 | sed 's/^/   /'
for opt in animations:enabled misc:disable_hyprland_logo misc:disable_splash_rendering \
           ecosystem:no_update_news ecosystem:no_donation_nag; do
    echo "   $opt: $("$VM" session hyprctl -j getoption "$opt" | python3 -c 'import json,sys; o=json.load(sys.stdin); print({k:v for k,v in o.items() if k!="option"})')"
done
# Pointer must be composited into frames (QMP screendump omits a hardware
# cursor plane): move it, then check the DRM cursor plane is unused.
"$VM" move 640 400 >/dev/null
"$VM" ssh qa-cursor-plane | sed 's/^/   /' || die "hardware cursor plane in use: the pointer would be missing from frames"
# USB input must not runtime-suspend (adds ~100 ms to the next key press).
sleep 6
usb=$("$VM" ssh 'for d in /sys/bus/usb/devices/*; do [ -f "$d/product" ] && echo "$(cat "$d/product"): $(cat "$d/power/runtime_status")"; done; true')
printf '%s\n' "$usb" | sed 's/^/   usb /'
printf '%s\n' "$usb" | grep -q 'Keyboard: active$' || die "USB keyboard is not runtime-active after 6 s idle"
! printf '%s\n' "$usb" | grep -q ': suspended$' || die "a USB device runtime-suspended despite the udev rule"
# The pointer must be the session theme's left_ptr, not Hyprland's built-in
# fallback (drawn when no cursor theme loads): the env clients inherit, then a
# screendump at a known position against the theme's own image.
r=$("$VM" session hyprctl dispatch 'hl.dsp.exec_cmd("printenv XCURSOR_THEME XCURSOR_SIZE >/tmp/hypr-qa-xcursor-env")')
[ "$r" = ok ] || die "hyprctl dispatch exec_cmd replied: $r"
sleep 1
xenv=$("$VM" ssh 'cat /tmp/hypr-qa-xcursor-env 2>/dev/null; rm -f /tmp/hypr-qa-xcursor-env' | tr '\n' ' ')
echo "   session XCURSOR_THEME XCURSOR_SIZE: $xenv"
[ "$xenv" = "$CURSOR_THEME $CURSOR_SIZE " ] || die "session cursor env is '$xenv', want '$CURSOR_THEME $CURSOR_SIZE'"
"$VM" ssh "base64 -w0 /usr/share/icons/$CURSOR_THEME/cursors/left_ptr" | base64 -d >"$VMKIT_DIR/left_ptr.xcursor" \
    || die "no /usr/share/icons/$CURSOR_THEME/cursors/left_ptr in the guest"
"$VM" move 640 400 >/dev/null; sleep 0.5
"$VM" shot pointer-check >/dev/null || die "screendump failed"
python3 "$HERE/check-pointer" "$VMKIT_DIR/pointer-check.png" 640 400 "$VMKIT_DIR/left_ptr.xcursor" "$CURSOR_SIZE" \
    | sed 's/^/   /' || die "the pointer is not $CURSOR_THEME's left_ptr (see $VMKIT_DIR/pointer-check.png)"
"$VM" wait screen 60 3 >/dev/null || echo "   (screen did not settle within 60 s; snapshotting anyway)"

phase "snapshot"
"$VM" snapshot "$SNAPSHOT" || die "snapshot failed"

phase "shutdown"
pid=$(cat "$VMKIT_DIR/qemu.pid" 2>/dev/null || true)   # qemu removes it on exit
"$VM" down >/dev/null
for _ in $(seq 1 60); do [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || break; sleep 1; done
[ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null || die "qemu (pid $pid) still running after down"
qemu-img snapshot -l "$OVERLAY" | grep -q " $SNAPSHOT " || die "snapshot $SNAPSHOT missing from $OVERLAY"
qemu-img check -q "$OVERLAY" || die "qemu-img check failed on $OVERLAY"

phase end
echo "== done in $(( $(date +%s) - T0 ))s: $OVERLAY (snapshot $SNAPSHOT)"
printf '   %s\n' "${TIMINGS[@]}"
