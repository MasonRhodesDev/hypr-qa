# plain-hyprland: shared settings for `build` and `vm`. Sourced, not executed.
# Every value can be overridden from the environment.

PROFILE="${PROFILE:-plain-hyprland}"

# vmkit (absolute: a non-interactive ssh PATH lacks ~/.local/bin).
VMKIT="${VMKIT:-$HOME/repos/vmkit/bin/vmkit}"

# Images live on the KVM host, outside any repo.
HQA_VMS="${HQA_VMS:-$HOME/vms/hypr-qa}"
BASE_DIR="${BASE_DIR:-$HQA_VMS/base}"                  # cached Arch cloud images
PROFILE_DIR="${PROFILE_DIR:-$HQA_VMS/$PROFILE}"
OVERLAY="${OVERLAY:-$PROFILE_DIR/$PROFILE.qcow2}"      # per-profile overlay (holds the snapshot)
SEED="${SEED:-$PROFILE_DIR/seed.iso}"                  # cloud-init NoCloud seed
VMKIT_DIR="${VMKIT_DIR:-$PROFILE_DIR/.vmkit}"          # qmp.sock, serial.log, shots

# Arch Linux cloud image index (the newest dated build is picked from it).
ARCH_IMAGES_URL="${ARCH_IMAGES_URL:-https://geo.mirror.pkgbuild.com/images/latest}"

SSH_PORT="${SSH_PORT:-2232}"       # host 127.0.0.1:2232 -> guest :22
VNC_DISPLAY="${VNC_DISPLAY:-32}"   # host 127.0.0.1:5932 (shared human view)
QA_USER=qa
SSH_KEY="${SSH_KEY:-$HOME/.ssh/id_ed25519}"
SSH_PUB="${SSH_PUB:-$SSH_KEY.pub}"
MEM="${MEM:-4096}"
SMP="${SMP:-4}"
DISK_SIZE="${DISK_SIZE:-20G}"

SNAPSHOT="${SNAPSHOT:-session-ready}"

# Display. HEADS virtio-gpu outputs (Virtual-1, Virtual-2, ...). GPU_MODES is one WxH per
# head, comma separated (vmkit up --gpu-modes); LAYOUT is the heads' rectangles in the
# compositor's logical pixels, "X,Y,W,H;X,Y,W,H" in head order (vmkit --layout), which
# the pointer commands map over when HEADS > 1.
# EXPECT_MONITORS is what build asserts: NAME:WxH:SCALE per output.
HEADS="${HEADS:-1}"
GPU_MODES="${GPU_MODES:-}"
LAYOUT="${LAYOUT:-}"
EXPECT_MONITORS="${EXPECT_MONITORS:-Virtual-1:1280x800:1}"
POINTER_CHECK="${POINTER_CHECK:-1}"   # 0: skip build's pointer-image check (it assumes one scale-1 head)

# A derived profile (profiles/<name>/, with its own profile.env that sets
# PROFILE and then sources this file) can add to the build through
# HQA_EXTRA_DIR, a directory holding any of: pre-install.sh (runs as root
# before the package install), packages.txt (extra pacman packages),
# post-install.sh (as root, after), hyprland-extra.lua (appended to the
# session config), post-session.sh (on the host, given the vm wrapper; runs
# after the session checks, before the snapshot).
HQA_EXTRA_DIR="${HQA_EXTRA_DIR:-}"

# ionice class for qemu (passed to vmkit, which applies its own) and the heavy
# build steps. 2 (best-effort), not 3 (idle): on a shared host (the dev CT on
# the tower's storage, I/O pressure ~80%) idle-class I/O is starved outright,
# and a 3 GB loadvm read crawled at ~1 MB/s. 3 brings the old behaviour back
# on a quiet machine.
HQA_IONICE_CLASS="${HQA_IONICE_CLASS:-2}"

# The session's pointer theme; files/hyprland-qa.lua sets the same with hl.env,
# and build checks the pointer on screen against it.
CURSOR_THEME=Adwaita
CURSOR_SIZE=24
