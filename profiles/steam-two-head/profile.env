# steam-two-head: plain-hyprland with two virtio-gpu heads at two scales, and Steam
# installed and bootstrapped. Sourced, not executed. Run `build` and `vm` here.
#
#   Virtual-1  1536x960 at scale 1.5  (logical 1024x640, at 0x0)
#   Virtual-2  1024x768 at scale 1.0  (at 1024x0)
#
# Small on purpose: the guest has 3 GiB of RAM and no GPU, and what the
# scenarios measure is the scale, not the size.
HERE_PROFILE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE=steam-two-head
SSH_PORT="${SSH_PORT:-2233}"
VNC_DISPLAY="${VNC_DISPLAY:-33}"
MEM="${MEM:-3072}"
DISK_SIZE="${DISK_SIZE:-24G}"
HEADS=2
GPU_MODES="1536x960,1024x768"
LAYOUT="0,0,1024,640;1024,0,1024,768"      # logical pixels: Virtual-1 at 1.5 is 1024x640
EXPECT_MONITORS="Virtual-1:1536x960:1.5 Virtual-2:1024x768:1"
POINTER_CHECK=0
HQA_EXTRA_DIR="$HERE_PROFILE/extra"
. "$HERE_PROFILE/../plain-hyprland/profile.env"
