# desktop-boot: shared settings for `build`, `vm` and `install-desktop-boot`.
# Sourced, not executed. Every scalar can be overridden from the environment.

PROFILE=desktop-boot

# vmkit (absolute: a non-interactive ssh PATH lacks ~/.local/bin). Needs the
# multi-head vmkit (per-head shot/record, up --gpu-heads/--uefi).
VMKIT="${VMKIT:-$HOME/repos/vmkit/bin/vmkit}"

# Images live on the KVM host, outside any repo.
HQA_VMS="${HQA_VMS:-$HOME/vms/hypr-qa}"
BASE_DIR="${BASE_DIR:-$HQA_VMS/base}"                  # cached Arch cloud images (shared with plain-hyprland)
PROFILE_DIR="${PROFILE_DIR:-$HQA_VMS/$PROFILE}"
OVERLAY="${OVERLAY:-$PROFILE_DIR/$PROFILE.qcow2}"
SEED="${SEED:-$PROFILE_DIR/seed.iso}"                  # cloud-init NoCloud seed
VMKIT_DIR="${VMKIT_DIR:-$PROFILE_DIR/.vmkit}"          # qmp sockets, serial.log, efivars.fd, shots

ARCH_IMAGES_URL="${ARCH_IMAGES_URL:-https://geo.mirror.pkgbuild.com/images/latest}"

SSH_PORT="${SSH_PORT:-2233}"       # host 127.0.0.1:2233 -> guest :22
VNC_DISPLAY="${VNC_DISPLAY:-33}"   # host 127.0.0.1:5933 (shared human view of head 0)
QA_USER=qa                         # password "qa": a test VM only, never a real account
SSH_KEY="${SSH_KEY:-$HOME/.ssh/id_ed25519}"
SSH_PUB="${SSH_PUB:-$SSH_KEY.pub}"
MEM="${MEM:-4096}"
SMP="${SMP:-4}"
DISK_SIZE="${DISK_SIZE:-30G}"

# ---- the three outputs --------------------------------------------------------
# One virtio GPU ("gpu0") with three outputs: connectors Virtual-1..3 in the
# guest, head 0..2 for vmkit. vmkit enables heads 1 and 2 and gives each head
# its own mode (`up --gpu-modes`, via one VNC server per head, see vmkit's README),
# so the EDID of every connector lists exactly HEAD_MODES. The kernel's video=
# option (set by provision.sh) and the Hyprland monitor rule repeat the mode.
#
# Head 0 is the only head the firmware (OVMF) and GRUB light, like the centre
# ultrawide of the real machine, so it carries the ultrawide mode.
# Order: head 0 centre, head 1 left, head 2 right (portrait).
GPU_HEADS=3
HEAD_MODES=(3440x1440 1920x1080 3840x2160)    # mode of Virtual-1, -2, -3
HEAD_POS=(1920x0 0x0 5360x0)                  # Hyprland position (compositor space)
HEAD_TRANSFORM=(0 0 3)                        # Hyprland transform; 3 = portrait (rotated 270)
# The mode GRUB (and so desktop-boot's GRUB theme) uses. OVMF's GOP offers fixed
# modes up to 1920x1080 and more, but no 3440x1440, so head 0's own mode cannot be
# GRUB's: "no suitable video mode found" and a "Press any key" stall result. The
# kernel, Plymouth, the greeter and the session do use head 0's real mode.
GRUB_MODE=1920x1080
# Kernel panel orientation per connector (for the splash on the rotated screen),
# desktop-boot's PANEL_ORIENTATION. Virtual-3 is the portrait one.
PANEL_ORIENTATION="Virtual-3:right_side_up"

# desktop-boot / vigil debug stage tags (corner label + edge border per stage).
DEBUG_STAGE_TAGS="${DEBUG_STAGE_TAGS:-1}"
