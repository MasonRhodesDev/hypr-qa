#!/usr/bin/env bash
# vm — drive the desktop-boot guest through vmkit with this profile's flags.
#
#   vm up                  cold boot (UEFI, 3 heads, headless, VNC :33, ssh 2233), niced
#   vm down                graceful power off
#   vm reset               hard reset (QMP system_reset): a cold reboot without ssh
#   vm layout              the --layout string for pointer commands (see below)
#   vm session CMD...      run CMD in the guest's Hyprland session (qa-session)
#   vm <anything else>     passed to vmkit with this profile's flags: shot --heads,
#                          heads, find --head N, record start --heads all, ssh, ...
#
# There are no snapshots: savevm cannot snapshot OVMF's writable pflash, so every
# run is a cold boot (the point of this profile).
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=profile.env
. "$HERE/profile.env"

# Head rectangles in Hyprland's compositor space, in head order, for vmkit's
# head-aware pointer mapping ("X,Y,W,H;..."). A rotated head (transform 1 or 3)
# is H x W there.
layout() {
    local i out="" w h x y
    for i in "${!HEAD_MODES[@]}"; do
        w=${HEAD_MODES[$i]%x*}; h=${HEAD_MODES[$i]#*x}
        x=${HEAD_POS[$i]%x*}; y=${HEAD_POS[$i]#*x}
        case "${HEAD_TRANSFORM[$i]}" in 1|3|5|7) set -- "$h" "$w";; *) set -- "$w" "$h";; esac
        out+="${out:+;}$x,$y,$1,$2"
    done
    printf '%s' "$out"
}

vk() {
    VMKIT_LAYOUT="$(layout)" "$VMKIT" --overlay "$OVERLAY" --cidata "$SEED" --dir "$VMKIT_DIR" \
        --ssh-port "$SSH_PORT" --ssh-user "$QA_USER" --ssh-key "$SSH_KEY" \
        --mem "$MEM" --smp "$SMP" --view "vnc:$VNC_DISPLAY" \
        --gpu-heads "$GPU_HEADS" --gpu-modes "$(IFS=,; echo "${HEAD_MODES[*]}")" --uefi "$@"
}

qmp_alive() { [ -S "$VMKIT_DIR/qmp.sock" ] && vk qmp '{"execute":"query-status"}' >/dev/null 2>&1; }

cmd_up() {
    if qmp_alive; then echo "already up (ssh $SSH_PORT, vnc 127.0.0.1:$((5900 + VNC_DISPLAY)))"; return 0; fi
    if ss -ltn 2>/dev/null | grep -q "127.0.0.1:$SSH_PORT "; then
        echo "vm: 127.0.0.1:$SSH_PORT is held by another process; not booting (SSH_PORT=...)" >&2; return 1
    fi
    if ss -ltn 2>/dev/null | grep -q "127.0.0.1:$((5900 + VNC_DISPLAY)) "; then
        echo "vm: VNC port $((5900 + VNC_DISPLAY)) is held by another process (VNC_DISPLAY=...)" >&2; return 1
    fi
    [ -f "$OVERLAY" ] || { echo "vm: no overlay at $OVERLAY; run build first" >&2; return 1; }
    [ -f "$SEED" ] || { echo "vm: no seed ISO at $SEED; run build first" >&2; return 1; }
    mkdir -p "$VMKIT_DIR"
    setsid -w nice -n 19 ionice -c3 "$0" _up >"$VMKIT_DIR/up.log" 2>&1 </dev/null
    cat "$VMKIT_DIR/up.log"
    local i
    for i in $(seq 1 50); do
        if qmp_alive && [ -s "$VMKIT_DIR/qemu.pid" ] && kill -0 "$(cat "$VMKIT_DIR/qemu.pid")" 2>/dev/null; then return 0; fi
        sleep 0.2
    done
    echo "vm: qemu did not come up; see $VMKIT_DIR/up.log" >&2; return 1
}

cmd="${1:-status}"; shift || true
case "$cmd" in
    up)      cmd_up ;;
    _up)     vk up ;;
    reset)   vk qmp '{"execute":"system_reset"}' >/dev/null; echo "reset" ;;
    layout)  layout; echo ;;
    session) [ $# -gt 0 ] || { echo "usage: vm session CMD..." >&2; exit 2; }
             vk ssh "qa-session $(printf '%q ' "$@")" ;;
    env)     echo "overlay=$OVERLAY seed=$SEED dir=$VMKIT_DIR ssh=127.0.0.1:$SSH_PORT vnc=127.0.0.1:$((5900 + VNC_DISPLAY)) layout=$(layout)" ;;
    *)       vk "$cmd" "$@" ;;
esac
